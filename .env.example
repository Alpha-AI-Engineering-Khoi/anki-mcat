# MCAT study app — local environment config.
#
# Copy this file to `.env` in this same directory (the repo root, where you run
# `./run`) and fill in your key:  cp .env.example .env
#
# `.env` is gitignored and must NEVER be committed. This `.env.example` is the
# safe, committed template. The app searches for `.env` from qt/aqt upward and
# STOPS at this repo root, so keep your real `.env` here (not in a parent dir).

# Your OpenAI API key. Required for the LIVE AI: Draft (card generation),
# the Card Check judge, and paraphrase questions. WITHOUT it — or with
# MCAT_OFFLINE set — the app runs fully with AI OFF: deterministic drafting,
# the structural screen, and all three scores still compute.
OPENAI_API_KEY=sk-your-key-here

# Force AI OFF regardless of any key (the kill-switch). Uncomment to use.
# MCAT_OFFLINE=1
# MCAT_AI_DISABLED=1

# Model overrides (default: gpt-4o-mini). Per-task overrides are supported, so
# the safety-critical judge can run on a stronger model than the drafter.
# MCAT_OPENAI_MODEL=gpt-4o-mini
# MCAT_OPENAI_MODEL_JUDGE=gpt-4o
# MCAT_OPENAI_MODEL_DRAFT=gpt-4o-mini
